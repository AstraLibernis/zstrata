//
// Crossover task "map": y[i] = a * x[i] + b. Simple and memory-bound.
#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform Push { uint n; float a; float b; } pc;
layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { float y[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) y[i] = fma(pc.a, x[i], pc.b);
}
